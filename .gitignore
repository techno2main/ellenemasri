# Ignorer toute l'arborescence WordPress de em-site, sauf le thème personnalisé
# Ignorer tout ce qui se trouve directement sous em-site/wp
em-site/wp/*
# Réinclure wp-content pour que Git puisse y descendre
!em-site/wp/wp-content/
# Ignorer tout le contenu de wp-content par défaut
em-site/wp/wp-content/*
# Réinclure le dossier themes
!em-site/wp/wp-content/themes/
# Ignorer tous les thèmes par défaut
em-site/wp/wp-content/themes/*
# Réinclure le dossier du thème personnalisé actif
!em-site/wp/wp-content/themes/em-site/
# Réinclure tout le contenu du thème personnalisé actif
!em-site/wp/wp-content/themes/em-site/**
# Ignorer le fichier de configuration WordPress local
em-site/wp/wp-config.php

# Deployment-only root files
/.htaccess
/index.php

# Ignorer le dossier docker de em-site, qui contient des fichiers sensibles
em-site/docker/

# Documentations & exports SQL locaux (sensibles/volumineux)
em-site/documentation/arborescence/
em-site/documentation/bdd/

